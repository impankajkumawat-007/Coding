import java.util.Stack

fun main() {
	val isAllParenthesesProper = checkForParanthesesWithoutStack("{()[{}]{}}")
    if (isAllParenthesesProper) {
        System.out.println("Parentheses are proper")
    } else {
        System.out.println("Parentheses are not proper")
    }
}

fun checkForParanthesesWithoutStack(dataString: String) : Boolean {
 	var top = -1
    var tempString = CharArray(dataString.length)
    for ((index, value) in dataString.withIndex()) {
        if (dataString[index] == '(' || dataString[index] == '{' || dataString[index] == '[') {
            tempString[++top] = dataString[index]
        } else if (dataString[index] == ')' || dataString[index] == '}' || dataString[index] == ']') {
            if (top == -1) return false
            if ((dataString[index] == ')' && tempString[top] != '(') ||
                    (dataString[index] == '}' && tempString[top] != '{') ||
                    (dataString[index] == ']' && tempString[top] != '[')) {
                return false
            }
            top--
        } 
    }
    return top == -1
}

fun checkForParentheses(dataString: String) : Boolean {
    val stack = Stack<Char>()
    for (dataChar in dataString) {
        if (stack.isEmpty()) {
            System.out.println("Stack Empty push - $dataChar")
            stack.push(dataChar)
        } else {
            val areItemMatched = isOppositeParantheses(stack.peek(), dataChar)
            if (areItemMatched) {
                System.out.println("Stack matched!!")
                stack.pop()
            } else {
                System.out.println("Stack pushed - $dataChar")
                stack.push(dataChar)
            }
        }
    }
    return stack.isEmpty()
}

fun isOppositeParantheses(previousValue: Char, currentValue: Char) : Boolean {
    if (previousValue == '(') {
       return currentValue == ')'
    } else if (previousValue == '[') {
       return currentValue == ']'
    } else if (previousValue == '{') {
       return currentValue == '}'        
    } else {
        return false
    }
}
